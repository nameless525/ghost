{
  "name": "ghost",
  "productName": "GHOST",
  "version": "0.3.0",
  "description": "GHOST — Game Haven OST. Stream any video game soundtrack.",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "build:native": "node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "add-dep": "node scripts/add-dep.mjs",
    "dist": "npm run build:native && electron-vite build && electron-builder",
    "dist:dir": "npm run build:native && electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "music-metadata": "^12.2.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@napi-rs/cli": "^3.10.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.57.0",
    "nanoid": "^6.0.2",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron@44.7.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "author": "GHOST"
}
